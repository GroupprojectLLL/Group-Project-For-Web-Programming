# Copy this file to backend/.env and replace the placeholder values.
MSSQL_SERVER=db
MSSQL_DB=StoreDB
MSSQL_USER=sa
MSSQL_SA_PASSWORD=replace-with-your-local-storedb-password

JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES=3600

NOCO_URL=http://noco:8080
NOCO_API_TOKEN=replace-with-your-nocodb-personal-access-token
